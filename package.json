{
  "name": "film",
  "private": true,
  "version": "1.0.0",
  "description": "Онлайн-кинотеатр с легальными полными фильмами из общественного достояния",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "build:demo": "VITE_DEMO=1 vite build --base ./ --outDir dist-demo",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "npm run build && npm start",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
